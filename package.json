{
    "name": "succubus-club",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "A platform to play the card game V:TES in a web browser. Built with Phaser, Vue, and TypeScript.",
    "repository": {
        "type": "git",
        "url": "https://github.com/thomasWajs/succubus-club"
    },
    "author": "Thomas Wajs",
    "license": "MIT",
    "licenseUrl": "https://mit-license.org/",
    "bugs": {
        "url": "https://github.com/thomasWajs/succubus-club/issues/"
    },
    "homepage": "https://succubus-club.net/",
    "keywords": [
        "phaser",
        "phaser3",
        "typescript",
        "vue",
        "vite"
    ],
    "workspaces": [
        "src/server",
        "src/client"
    ],
    "dependencies": {
        "@vercel/og": "0.11.1"
    },
    "scripts": {
        "dev": "vite --config vite/config.dev.mjs",
        "preview": "vite preview",
        "build": "vite build --config vite/config.prod.mjs",
        "loadtest": "node script/lobbySim.mjs",
        "type:check": "vue-tsc --noEmit",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "server:dev": "cd src/server && npm run dev",
        "server:start": "cd src/server && npm run start"
    },
    "devDependencies": {
        "firebase-admin": "^14.4.0"
    }
}
